# ===== 应用 =====
APP_NAME=rag-platform
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ===== 安全 =====
# JWT 签名密钥，生产环境务必换成强随机值
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 数据库 / 队列 / 向量库（compose 内联地址会覆盖这里，本地开发用这些） =====
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0
VECTOR_URI=http://localhost:19530

# ===== 模型服务（OpenAI 兼容，可切 DeepSeek / Qwen / OpenAI）=====
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3

# ===== 文档处理（W1）=====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_BACKEND=mock
EMBEDDING_DIM=1024
INGESTION_MODE=async
MILVUS_COLLECTION=rag_chunks
