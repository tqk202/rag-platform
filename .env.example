# ===== 应用 =====
APP_NAME=rag-platform
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1

# ===== 安全（生产务必换成强随机值：openssl rand -hex 32）=====
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 数据库 / 队列 / 向量库（compose 内联地址会覆盖这里，本地开发用这些）=====
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0
VECTOR_URI=http://localhost:19530

# ===== 模型服务（OpenAI 兼容，可切 DeepSeek / Qwen / OpenAI）=====
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# ===== 重排（真实 cross-encoder 走 SiliconFlow /rerank）=====
RERANKER_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ===== 文档处理（W1）=====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_BACKEND=api      # mock | api | local；生产 api（真实 bge-m3）
EMBEDDING_DIM=1024
INGESTION_MODE=async       # async(Celery 生产) | inline(开发直接处理)
MILVUS_COLLECTION=rag_chunks

# ===== 上传安全边界（W6）=====
ALLOWED_UPLOAD_EXTENSIONS=.txt,.md,.pdf,.doc,.docx
MAX_UPLOAD_SIZE_MB=20
